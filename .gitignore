__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.coverage
*.egg-info/
.DS_Store
.claude/
notes/skyrim-modlist-research/

# Playwright MCP tool scratch (screenshots/snapshots from live-browser
# verification sessions) -- local-only, recurs across every agent session
# that uses the MCP browser tools for the live-verification convention.
.playwright-mcp/

# Dashboard (Vue/Vite/npm)
dashboard/node_modules/
dashboard/dist/

# ChronicleBridge listener's rolling live-position snapshot -- runtime
# output, not a fixture; regenerated every session the listener runs.
adapters/skyrim/listener/whiterun-positions.json

# Sim run logs (chronicle/framelog.py output) -- never committed, see
# docs/ui-spec.md's runs/ registry.
runs/

# Exception: the lane-6 mock-run fixture is a *committed* dev/CI fixture
# (docs/work-packets/lane-6-m1-reader-chrome.md), deliberately placed
# under dashboard/public/runs/ so Vite serves it identically to a real run
# in both `vite dev` and `vite preview` -- see dashboard/README.md's "Mock
# run fixture" section. Without this, the bare `runs/` pattern above (no
# leading slash, so it matches a `runs` directory at any depth) would
# silently swallow it too.
!dashboard/public/runs/
!dashboard/public/runs/**

# chronicle-patcher (C#/.NET Mutagen console app) -- standard .NET build
# output, plus its generated ChroniclePatcher.esp game-content output.
# Same posture as ChronicleBridge's own .dll: never committed, built as a
# documented one-time/repeatable step against the owner's own load order
# (see tools/chronicle-patcher/README.md).
tools/chronicle-patcher/**/bin/
tools/chronicle-patcher/**/obj/
tools/chronicle-patcher/out/

# Session/handoff working notes -- internal process artifacts, not meant
# for a public reader landing on the repo (docs/work-packets/reviews/
# README.md's coordinator/lane-worker log lives in docs/, this doesn't).
/HANDOFF-*.md
/claude-sessions/

# mkdocs build output -- regenerated by `mkdocs build` / the docs.yml
# GitHub Actions workflow, never committed.
/site/

# ChronicleBridge's standalone sync-handshake-core test binary -- a plain
# g++/clang++ build artifact (see adapters/skyrim/ChronicleBridge/tests/
# Makefile), same posture as the .NET/.dll build outputs above.
adapters/skyrim/ChronicleBridge/tests/test_sync_handshake_core
