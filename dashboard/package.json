    "check-range": "node scripts/check-range.mjs --both",
    "visual-diff": "node scripts/visual-diff.mjs"
  },
  "dependencies": {
    "@tanstack/vue-virtual": "3.13.36",
    "@vueuse/core": "14.4.0",
    "@vueuse/router": "14.4.0",
    "pinia": "4.0.3",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "jsdom": "30.0.1",
    "pixelmatch": "7.2.0",
    "playwright": "1.62.1",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
